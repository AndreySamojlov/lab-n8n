      "name": "Только с заполненной категорией"
    },
    {
      "parameters": {
        "jsCode": "const allSheets = $('Start').all();\n\nfunction escapeRegExp(str) {\n  return str.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\nreturn items.map(item => {\n  const category = String(item.json[\"Категория 1\"] || \"\").trim();\n\n  if (!category) {\n    return item;\n  }\n\n  const categoryRe = escapeRegExp(category);\n\n  const matching = allSheets\n    .map(s => String(s.json.sheetName || \"\").trim())\n    .filter(name =>\n      name === category || name.match(new RegExp(`^${categoryRe} \\\\d+$`))\n    );\n\n  let nextNumber = 1;\n\n  if (matching.length) {\n    const numbers = matching.map(name => {\n      if (name === category) return 1;\n\n      const match = name.match(/(\\d+)$/);\n      return match ? Number(match[1]) : 1;\n    });\n\n    nextNumber = Math.max(...numbers) + 1;\n  }\n\n  return {\n    json: {\n      ...item.json,\n      sheetName: nextNumber === 1\n        ? category\n        : `${category} ${nextNumber}`\n    }\n  };\n});"
      },
