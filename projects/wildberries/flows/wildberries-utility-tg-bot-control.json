      "parameters": {
        "jsCode": "const update = $json;\n\nif (update.callback_query) {\n  const cb = update.callback_query;\n  const data = (cb.data || '').toLowerCase().trim();\n  const valid = ['включить', 'выключить', 'статус'];\n  const action = valid.includes(data) ? data : 'menu';\n  return [{\n    json: {\n      action,\n      chatId: String(cb.message?.chat?.id || ''),\n      callbackQueryId: String(cb.id || '')\n    }\n  }];\n}\n\nif (update.message) {\n  return [{\n    json: {\n      action: 'menu',\n      chatId: String(update.message?.chat?.id || '')\n    }\n  }];\n}\n\nreturn [];"
      },
