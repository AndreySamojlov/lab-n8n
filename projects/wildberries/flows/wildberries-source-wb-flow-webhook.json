    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n\n  const values = data.values || [];\n  const headers = values[0] || [];\n  const firstDataRow = values[1] || [];\n\n  const sheetName = String(data.range || \"\")\n    .split(\"!\")[0]\n    .replace(/^'/, \"\")\n    .replace(/'$/, \"\");\n\n  const fieldCount = headers.length;\n  const hasRowData = firstDataRow.some(cell => String(cell || \"\").trim() !== \"\");\n\n  let resolution = \"old\";\n  if (fieldCount <= 3) {\n    resolution = hasRowData ? \"new\" : \"template\";\n  }\n\n  return {\n    json: {\n      sheetName,\n      fieldCount,\n      resolution\n    }\n  };\n});\n"
      },
