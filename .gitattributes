# Normalize all text files to LF in the repo.
# Working tree checks out with LF on any OS (incl. Windows).

* text=auto eol=lf

# Explicit: scripts, configs, workflow JSONs never CRLF.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binary — don't touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.gz   binary
